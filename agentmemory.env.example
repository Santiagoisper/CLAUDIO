# Copiá este archivo a: %USERPROFILE%\.agentmemory\.env
# (C:\Users\Santiago\.agentmemory\.env)
#
# Creá la carpeta si no existe:
#   mkdir %USERPROFILE%\.agentmemory
#
# Luego copiá:
#   copy agentmemory.env.example %USERPROFILE%\.agentmemory\.env
# Y editá los valores.

# --- Seguridad ---
# Token para proteger la API REST de agentmemory (mínimo 32 chars)
AGENTMEMORY_SECRET=cambia-esto-por-un-token-largo-de-32-chars-minimo

# --- Captura automática ---
# OFF por defecto: evita mandar cada observación a un LLM externo.
# Ponelo en true solo si querés compresión semántica automática con tu API key.
AGENTMEMORY_AUTO_COMPRESS=false

# --- Inyección de contexto al inicio de sesión ---
# OFF por defecto. Cuando está en true, agentmemory inyecta ~1-2K chars
# de contexto del proyecto al arrancar cada sesión en Claude Code.
AGENTMEMORY_INJECT_CONTEXT=false

# --- Proveedor LLM (opcional) ---
# Si querés compresión semántica real, descomentá uno:
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# --- Embeddings locales (recomendado, gratis) ---
# Instalá con: npm install @xenova/transformers
# agentmemory lo detecta automáticamente si está instalado.
# EMBEDDING_PROVIDER=local

# --- Puertos (defaults) ---
# III_REST_PORT=3111
# AGENTMEMORY_VIEWER_PORT=3113

# --- Features opcionales ---
# AGENTMEMORY_SLOTS=false
# AGENTMEMORY_REFLECT=false
# GRAPH_EXTRACTION_ENABLED=false
