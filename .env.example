CLAUDIO_DB_PATH=./data/claudio.db
DATABASE_URL=
NEON_DATABASE_URL=
CLAUDIO_TOKEN=change_this_with_a_minimum_32_char_token
# Modo HTTP/SSE (panel web, Railway, clients MCP por red). Si no definís PORT, el servidor arranca en stdio (Claude Code, etc.).
# Panel + Vite local: definí PORT distinto de 3000 (puerto de Vite), p. ej. PORT=3737, y el mismo host en VITE_CLAUDIO_API_URL.
PORT=
CLAUDIO_MAX_HTTP_BODY_BYTES=41943040
CLAUDIO_ENABLE_SHELL=false

# Base del servidor remoto para tools/remember.ts (CLI contra producción u otro host). Si está vacío, usa el default del script.
CLAUDIO_REMOTE_URL=
# Sólo para una migración puntual de memoria al servidor remoto. Dejar vacío al terminar.
CLAUDIO_MIGRATION_TOKEN=

# Panel Vite (`npm run dev` sirve la UI en :3000). Esta URL debe ser el MCP HTTP (mismo host/puerto que PORT).
VITE_CLAUDIO_API_URL=http://localhost:3737
VITE_CLAUDIO_TOKEN=

# Google (opcional — para Gmail y Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
# Cuenta secundaria opcional: conserva un token OAuth distinto para CINME.
CINME_GOOGLE_REFRESH_TOKEN=
CLAUDIO_ENABLE_GOOGLE_WRITE=false

# GitHub (opcional — para herramientas de repos)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_ALLOWED_API_HOSTS=
CLAUDIO_ENABLE_GITHUB_WRITE=false

# Web / Búsqueda
BRAVE_API_KEY=          # https://brave.com/search/api/ — gratis hasta 2k req/mes

# Embeddings semánticos (habilita claudio_recall_semantic)
OPENAI_API_KEY=         # modelo: text-embedding-3-small (~$0.02/millón tokens)

# IA para análisis de documentos/correo
# Selector UI soportado: openai, groq, deepseek, anthropic, gemini, ollama.
CLAUDIO_AI_PROVIDER=openai
CLAUDIO_AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLAUDIO_OLLAMA_URL=http://localhost:11434
