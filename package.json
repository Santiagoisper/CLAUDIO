  "type": "module",
  "scripts": {
    "dev:mcp": "tsx watch --env-file=.env src/server.ts",
    "start:mcp": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc",
    "db:init": "tsx src/db/init.ts",
