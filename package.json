  "description": "CLAUDIO — Asistente personal de Santiago",
  "type": "module",
  "scripts": {
    "dev:mcp": "tsx --env-file=.env src/server.ts",
    "mcp": "tsx --env-file=.env src/server.ts",
    "dev:web": "cd web && vite --config ../vite.config.ts",
    "dev": "concurrently \"npm run dev:mcp\" \"npm run dev:web\"",
    "build": "tsc && cd web && vite build --config ../vite.config.ts",
    "setup:machine": "node scripts/setup-machine.mjs",
    "memory:migrate:remote": "node --experimental-sqlite --env-file=.env scripts/migrate-memory-to-remote.mjs",
    "start:mcp": "node --disable-warning=ExperimentalWarning dist/server.js",
    "db:init": "tsx src/db/init.ts",
    "db:export": "tsx src/tools/export.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
